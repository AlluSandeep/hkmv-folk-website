rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'folks_head'];
    }

    // Everything requires a logged-in user
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Users: read anyone authed; write own doc or admin (prevents users editing others' roles)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId || isAdmin();
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
